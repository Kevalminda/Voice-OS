# Gemini is used only by the existing command pipeline, not STT/normalization.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_ATTEMPTS=3
VOICEOS_LOG_LEVEL=INFO

# Local speech configuration
VOICEOS_STT_MODEL=small
VOICEOS_STT_DEVICE=auto
VOICEOS_STT_COMPUTE_TYPE=auto
# auto prefers CUDA float16 and CPU float32; explicit CPU int8 is available for evaluation.
# Preferred decoder language: auto, en or hi. CLI --language/--preferred-language overrides it.
# English preference does not imply all Hinglish should be decoded as English.
VOICEOS_STT_LANGUAGE=auto
# Blank selects the OS default input; ID or an unambiguous device name is accepted.
VOICEOS_MICROPHONE=
VOICEOS_RECORD_SECONDS=12
# The normal voice loop ends on silence; duration above is for fixed diagnostic capture.
VOICEOS_RECORDING_MODE=automatic
VOICEOS_SILENCE_SECONDS=2
VOICEOS_MAX_RECORD_SECONDS=60
VOICEOS_INITIAL_SILENCE_SECONDS=8
VOICEOS_CAPTURE_VAD_THRESHOLD=0.5
VOICEOS_SPEECH_START_MS=96
VOICEOS_SILENCE_RMS=0.001
VOICEOS_STT_BEAM_SIZE=5
VOICEOS_STT_VAD=true
VOICEOS_VAD_MIN_SILENCE_MS=500
VOICEOS_VAD_SPEECH_PAD_MS=300
VOICEOS_VAD_THRESHOLD=0.5
# Per-segment detection is evaluated only in auto mode; explicit en/hi stays forced.
VOICEOS_STT_MULTILINGUAL=true
# Preserve the established fallback schedule; benchmark a single 0 separately.
VOICEOS_STT_TEMPERATURES=0,0.2,0.4,0.6,0.8,1
# Empty by default to avoid biasing mixed speech; add evaluated vocabulary hints explicitly.
VOICEOS_STT_PROMPT=
VOICEOS_STT_LOCAL_FILES_ONLY=false
VOICEOS_VOCABULARY_PATH=
# Optional lossless capture archive for investigations; blank leaves automatic saving disabled.
VOICEOS_RECORDING_DIRECTORY=
